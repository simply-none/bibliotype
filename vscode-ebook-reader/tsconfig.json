{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "declaration": true,
    "allowJs": true
  },
  "exclude": ["node_modules", ".vscode-test", "out"]
}
