{
  "name": "@bibliotype/vue",
  "version": "0.1.0",
  "description": "Vue 3 阅读器封装：useReader 组合式桥与 BookView / Pager / Toc 组件 - bibliotype 框架封装包",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@bibliotype/core": "workspace:*",
    "@bibliotype/editor": "workspace:*",
    "@bibliotype/layout": "workspace:*",
    "@bibliotype/reader": "workspace:*",
    "prosemirror-model": "^1.23.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/language-core": "^2.1.10",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
