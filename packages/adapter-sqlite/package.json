{
  "name": "@bibliotype/adapter-sqlite",
  "version": "0.1.0",
  "description": "SQLite 存储适配器：文档分片、资产 BLOB、书架摘要与历史版本（驱动由宿主注入） - bibliotype 存储包",
  "type": "module",
  "license": "MIT",
  "author": "bibliotype contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simply-none/bibliotype.git",
    "directory": "packages/adapter-sqlite"
  },
  "homepage": "https://github.com/simply-none/bibliotype/tree/master/packages/adapter-sqlite#readme",
  "bugs": {
    "url": "https://github.com/simply-none/bibliotype/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "tsup --clean"
  },
  "dependencies": {
    "@bibliotype/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.9",
    "sql.js": "^1.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
