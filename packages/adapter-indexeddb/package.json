{
  "name": "@bibliotype/adapter-indexeddb",
  "version": "0.1.0",
  "description": "IndexedDB 存储适配器（Web 端持久化）+ 内存适配器 - bibliotype 存储包",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "tsup --clean"
  },
  "dependencies": {
    "@bibliotype/core": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
