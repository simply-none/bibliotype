{
  "name": "@bibliotype/typography-cjk",
  "version": "26.10.25-rc.1",
  "description": "中文排印规则：禁则避头尾、标点挤压、中西文混排间距 - bibliotype 排印包",
  "type": "module",
  "license": "MIT",
  "author": "bibliotype contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simply-none/bibliotype.git",
    "directory": "packages/typography-cjk"
  },
  "homepage": "https://github.com/simply-none/bibliotype/tree/master/packages/typography-cjk#readme",
  "bugs": {
    "url": "https://github.com/simply-none/bibliotype/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "tsup --clean",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
