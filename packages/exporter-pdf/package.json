{
  "name": "@bibliotype/exporter-pdf",
  "version": "0.1.0",
  "description": "PDF 导出：IR → 打印文档（@page 尺寸 / 预分页固定页）+ 浏览器打印辅助（window.print）- bibliotype 导出包",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "tsup --clean"
  },
  "dependencies": {
    "@bibliotype/core": "workspace:*",
    "@bibliotype/layout": "workspace:*",
    "@bibliotype/reader": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
