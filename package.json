{
  "name": "bibliotype",
  "private": true,
  "version": "0.0.0",
  "description": "bibliotype 插件包组 - Web 端书籍级内容排版、编辑与阅读（含古籍支持）",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:full": "turbo run build --force",
    "dev": "turbo run dev",
    "dev:demo": "pnpm --filter @bibliotype/demo dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "stats": "node scripts/code-stats.mjs",
    "stats:json": "node scripts/code-stats.mjs --json",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:rc": "node scripts/version.mjs --channel rc",
    "version:latest": "node scripts/version.mjs --channel latest",
    "release:check": "node scripts/check-version.mjs && pnpm build && pnpm -r publish --dry-run --no-git-checks",
    "release:rc": "pnpm build && pnpm -r publish --tag rc --no-git-checks --access public",
    "release": "pnpm build && pnpm -r publish --tag latest --no-git-checks --access public",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^2.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
