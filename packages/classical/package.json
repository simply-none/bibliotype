{
  "name": "@bibliotype/classical",
  "version": "0.1.0",
  "description": "古籍专有节点与标记定义（双行小注、夹注、校勘、专名号等）- bibliotype 古籍包",
  "type": "module",
  "license": "MIT",
  "author": "bibliotype contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simply-none/bibliotype.git",
    "directory": "packages/classical"
  },
  "homepage": "https://github.com/simply-none/bibliotype/tree/master/packages/classical#readme",
  "bugs": {
    "url": "https://github.com/simply-none/bibliotype/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "tsup --clean",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bibliotype/core": "workspace:*",
    "@bibliotype/editor": "workspace:*",
    "prosemirror-model": "^1.23.0",
    "prosemirror-state": "^1.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
