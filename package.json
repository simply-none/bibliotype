{
  "name": "bibliotype",
  "private": true,
  "version": "0.0.0",
  "description": "bibliotype 插件包组 - Web 端书籍级内容排版、编辑与阅读（含古籍支持）",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:full": "turbo run build --force",
    "dev": "turbo run dev",
    "dev:demo": "pnpm --filter @bibliotype/demo dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "stats": "node scripts/code-stats.mjs",
    "stats:json": "node scripts/code-stats.mjs --json",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:rc": "node scripts/version.mjs --channel rc",
    "version:rc:all": "node scripts/version.mjs --channel rc --all",
    "version:latest": "node scripts/version.mjs --channel latest",
    "version:latest:reuse": "node scripts/version.mjs --channel latest --reuse-pending",
    "release:check": "node scripts/check-version.mjs && pnpm build && node scripts/publish.mjs --dry-run",
    "release:rc": "pnpm build && node scripts/publish.mjs --tag rc",
    "release": "pnpm build && node scripts/publish.mjs --tag latest",
    "test:coverage": "turbo run test:coverage",
    "size": "size-limit",
    "bench": "node bench/run.mjs",
    "bench:update": "node bench/run.mjs --update",
    "e2e": "pnpm --filter @bibliotype/e2e e2e",
    "e2e:smoke": "pnpm --filter @bibliotype/e2e e2e:smoke",
    "e2e:pixel": "pnpm --filter @bibliotype/e2e e2e:pixel",
    "e2e:update": "pnpm --filter @bibliotype/e2e e2e:update",
    "e2e:install": "pnpm --filter @bibliotype/e2e e2e:install"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@vitest/coverage-v8": "^2.1.0",
    "size-limit": "^11.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
