{
  "name": "@bibliotype/editor",
  "version": "0.1.0",
  "description": "基于 ProseMirror 的书籍编辑器核心：节点规格注册（D8）、IR 双向转换、无视图编辑状态机 - bibliotype 编辑包",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "tsup --clean"
  },
  "dependencies": {
    "@bibliotype/core": "workspace:*",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.0",
    "prosemirror-keymap": "^1.2.0",
    "prosemirror-model": "^1.23.0",
    "prosemirror-schema-list": "^1.4.0",
    "prosemirror-state": "^1.4.3"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
