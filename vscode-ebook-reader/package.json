{
  "name": "bioReader",
  "displayName": "bioReader",
  "description": "在 VSCode 中阅读 epub/txt/html/md 电子书",
  "version": "0.0.1",
  "type": "module",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bioReader.importBook",
        "title": "导入电子书",
        "category": "bioReader"
      },
      {
        "command": "bioReader.openBook",
        "title": "打开电子书",
        "category": "bioReader"
      },
      {
        "command": "bioReader.deleteBook",
        "title": "删除电子书",
        "category": "bioReader",
        "icon": "$(trash)"
      },
      {
        "command": "bioReader.refreshLibrary",
        "title": "刷新书库",
        "category": "bioReader",
        "icon": "$(refresh)"
      },
      {
        "command": "bioReader.goToTocPage",
        "title": "跳转到目录页",
        "category": "bioReader"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bioReader",
          "title": "bioReader",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "bioReader": [
        {
          "id": "bioReader-library",
          "name": "书库",
          "icon": "$(library)"
        },
        {
          "id": "bioReader-toc",
          "name": "目录",
          "icon": "$(list-tree)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bioReader.importBook",
          "when": "view == bioReader-library",
          "group": "navigation"
        },
        {
          "command": "bioReader.refreshLibrary",
          "when": "view == bioReader-library",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bioReader.deleteBook",
          "when": "view == bioReader-library && viewItem == book",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "bioReader",
      "properties": {
        "bioReader.fontSize": {
          "type": "number",
          "default": 16,
          "description": "阅读字体大小（px）"
        },
        "bioReader.lineHeight": {
          "type": "number",
          "default": 1.8,
          "description": "阅读行高（倍数）"
        },
        "bioReader.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "sepia"
          ],
          "default": "dark",
          "description": "阅读主题"
        },
        "bioReader.padding": {
          "type": "number",
          "default": 48,
          "description": "阅读区内容边距（px）"
        },
        "bioReader.textIndent": {
          "type": "number",
          "default": 2,
          "description": "段落首行缩进（em）"
        },
        "bioReader.backgroundColor": {
          "type": "string",
          "default": "",
          "description": "自定义背景色（留空使用主题色，如 #f5f5dc）"
        },
        "bioReader.textColor": {
          "type": "string",
          "default": "",
          "description": "自定义文字颜色（留空使用主题色，如 #333333）"
        },
        "bioReader.linkColor": {
          "type": "string",
          "default": "",
          "description": "自定义链接颜色（留空使用主题色，如 #0066cc）"
        },
        "bioReader.panelTitle": {
          "type": "string",
          "default": "",
          "description": "自定义页签标题（留空显示书名，如填「工作文档」则页签显示为「工作文档」）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@bibliotype/classical": "workspace:*",
    "@bibliotype/core": "workspace:*",
    "@bibliotype/import": "workspace:*",
    "@bibliotype/import-epub": "workspace:*",
    "@bibliotype/layout": "workspace:*",
    "@bibliotype/reader": "workspace:*",
    "happy-dom": "^15.11.0"
  }
}
